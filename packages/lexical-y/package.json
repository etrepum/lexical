{
  "name": "@lexical/y",
  "description": "Schema-based Yjs 14 collaboration extensions for Lexical.",
  "keywords": [
    "lexical",
    "editor",
    "rich-text",
    "collaboration",
    "yjs",
    "crdt"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "version": "0.52.0",
  "main": "./dist/LexicalY.js",
  "types": "./dist/typescript-too-old.d.ts",
  "dependencies": {
    "@lexical/extension": "workspace:*",
    "@lexical/history": "workspace:*",
    "@lexical/internal": "workspace:*",
    "@lexical/selection": "workspace:*",
    "lexical": "workspace:*",
    "lib0": "^1.0.0-rc.29"
  },
  "devDependencies": {
    "@y/protocols": "1.0.6-rc.1",
    "@y/y": "14.0.0-rc.26"
  },
  "peerDependencies": {
    "@y/y": "^14.0.0-rc.26",
    "typescript": ">=5.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facebook/lexical.git",
    "directory": "packages/lexical-y"
  },
  "module": "./dist/LexicalY.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types@<5.2": "./dist/typescript-too-old.d.ts",
      "types": "./dist/index.d.ts",
      "development": "./dist/LexicalY.dev.js",
      "production": "./dist/LexicalY.prod.js",
      "default": "./dist/LexicalY.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "!src/__bench__",
    "!src/__mocks__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.bench.ts",
    "!src/**/*.bench.tsx",
    "README.md",
    "LICENSE"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "./dist/typescript-too-old.d.ts"
      ]
    }
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "type": "module"
}
