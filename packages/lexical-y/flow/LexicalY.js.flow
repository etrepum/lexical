import type {LexicalEditor, LexicalExtension, BaseSelection, LexicalNode} from 'lexical';
import type {Signal} from '@lexical/extension';
import type {Doc, Node as YNode, RelativePosition, UndoManager, DiffRenderer, Delta, ContentMap} from '@y/y';

type YRangeSelection = {
  anchor: RelativePosition,
  focus: RelativePosition,
  anchorFallback?: Array<RelativePosition>,
  focusFallback?: Array<RelativePosition>,
  format: number,
  style: string,
};
export type YSelection = {kind: string, data: unknown, fallback?: YRangeSelection};
export type YNodeReference = {id: string, start?: RelativePosition, end?: RelativePosition};
export type YSelectionCodec = {
  kind: string,
  getNodesForHighlight?: (selection: BaseSelection) => LexicalNode[],
  encode(binding: YBinding, selection: BaseSelection): unknown | null,
  resolve(binding: YBinding, data: unknown, followUndoneDeletions: boolean): BaseSelection | null,
};
export type YBinding = {
  readonly doc: Doc,
  readonly error: Signal<Error | null>,
  readonly schemaId: string,
  readonly root: YNode,
  readonly editor: LexicalEditor,
  selection: YSelection | null,
  selectionBefore: YSelection | null,
  restoringSelection: YSelection | null | void,
  register(): () => void,
  registerProjectionTransform(transform: () => void): () => void,
  readonly selectionCodecs: Map<string, YSelectionCodec>,
  read(dirty?: ReadonlySet<string>, changed?: ReadonlySet<YNode>, structural?: boolean): void,
  bootstrap(initialize: () => void): void,
  transact(callback: () => void): void,
  releaseSharedType(type: YNode): void,
};
export type YConfig = {
  root: YNode | null,
  schemaId: string,
  ready: boolean,
  $initialState: (() => void) | null,
};
export type YProvider = {
  readonly synced: boolean,
  on(event: 'sync', listener: (synced: boolean) => void): unknown,
  off(event: 'sync', listener: (synced: boolean) => void): unknown,
};
export type YProviderConfig = {provider: YProvider | null};
export type YUser = {name: string, color: string, textColor: string};
export type YPresence = {user: YUser, selection: YSelection | null};
export type YAwareness = {
  clientID: number,
  getLocalState(): {[string]: unknown} | null,
  getStates(): Map<number, {[string]: unknown}>,
  setLocalStateField(field: string, value: unknown): void,
  on(event: 'change', listener: () => void): unknown,
  off(event: 'change', listener: () => void): unknown,
};
export type YAwarenessConfig = {
  awareness: YAwareness | null,
  field: string,
  user: YUser,
};
declare export function $getYSelection(binding: YBinding): YSelection | null;
declare export function $resolveYSelection(binding: YBinding, value: YSelection, followUndoneDeletions?: boolean): BaseSelection | null;
declare export var YExtension: LexicalExtension<YConfig, '@lexical/y', {
  binding: YBinding,
  ready: Signal<boolean>,
}, void>;
declare export var YHistoryExtension: LexicalExtension<{captureTimeout: number}, '@lexical/y/History', {
  canUndo: Signal<boolean>,
  canRedo: Signal<boolean>,
  undoManager: Signal<UndoManager | null>,
}, void>;
declare export var YProviderExtension: LexicalExtension<YProviderConfig, '@lexical/y/Provider', {provider: Signal<YProvider | null>, synced: Signal<boolean>}, void>;
declare export var YAwarenessExtension: LexicalExtension<YAwarenessConfig, '@lexical/y/Awareness', {
  user: Signal<YUser>,
  peers: Signal<Map<number, YPresence>>,
}, void>;
export type YCursorContext = {
  clientID: number,
  presence: YPresence,
  selection: BaseSelection,
  rects: Array<DOMRect>,
  caret: DOMRect | null,
  container: HTMLElement,
};
export type YCursorsConfig = {
  container: ((root: HTMLElement) => HTMLElement) | null,
  renderCursor: ((context: YCursorContext) => void | (() => void)) | null,
  className: string,
  zIndex: number,
};
declare export var YCursorsExtension: LexicalExtension<YCursorsConfig, '@lexical/y/Cursors', void, void>;

declare export function $getYNodeReference(binding: YBinding, node: LexicalNode): YNodeReference | null;
declare export function $resolveYNodeReference(binding: YBinding, value: YNodeReference, followUndoneDeletions?: boolean): LexicalNode[];
declare export function isYNodeReference(value: unknown): boolean;
declare export function registerYSelectionCodec(binding: YBinding, codec: YSelectionCodec): () => void;
export type YCheckpoint = {update: Uint8Array, root: RelativePosition};
export type YDocumentView = {doc: Doc, root: YNode, dispose(): void};
export type YAttributionConfig = {storage: YNode | null, author: string};
export type YSuggestion = {id: string, kind: 'text' | 'format' | 'property' | 'structure', insertedText: string, deletedText: string};
export type YSuggestionsConfig = {base: YBinding | null};
declare export function createYDocumentView(checkpoint: YCheckpoint, suggestion?: boolean): YDocumentView;
declare export function compareYCheckpoints(before: YCheckpoint, after: YCheckpoint): {
  before: YDocumentView, after: YDocumentView, renderer: DiffRenderer,
  getDelta(): Delta, dispose(): void,
};
declare export var YVersionsExtension: LexicalExtension<{}, '@lexical/y/Versions', {capture(): YCheckpoint}, void>;
declare export var YSuggestionsExtension: LexicalExtension<YSuggestionsConfig, '@lexical/y/Suggestions', {
  revision: Signal<number>, accept(id?: string): void, reject(id?: string): void, getSuggestions(): YSuggestion[], getDelta(): Delta, register(): () => void,
}, void>;
declare export var YAttributionExtension: LexicalExtension<YAttributionConfig, '@lexical/y/Attribution', {
  author: Signal<string>, revision: Signal<number>, getAttributions(): ContentMap, getDelta(): Delta,
}, void>;
