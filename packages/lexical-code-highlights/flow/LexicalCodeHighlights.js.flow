import type {
  LexicalEditor,
  LexicalExtension,
  LexicalNode,
  NodeKey,
} from 'lexical';
import type {NamedSignalsOutput} from '@lexical/extension';
import type {CodeNode} from '@lexical/code';

/**
 * LexicalCodeHighlights
 */

export type Tokenizer = {
  defaultLanguage: string | null;
  defaultTheme: string;
  $tokenize: (codeNode: CodeNode, language?: string) => Array<LexicalNode>;
}
export type CodeHighlightsConfig = {
  disabled: boolean,
  tokenizer: Tokenizer,
};
declare export var HighlightsTokenizer: Tokenizer;
declare export var CodeHighlightsExtension: LexicalExtension<CodeHighlightsConfig, "@lexical/code-highlights", NamedSignalsOutput<CodeHighlightsConfig>, void>;
declare export function registerCodeHighlighting(
  editor: LexicalEditor,
  tokenizer?: Tokenizer,
): () => void;
declare export function getCodeLanguageOptions(): Array<[string, string]>;
declare export function getCodeThemeOptions(): Array<[string, string]>;
declare export function isCodeLanguageLoaded(language: string): boolean;
declare export function isCodeThemeLoaded(theme: string): boolean;
declare export function loadCodeLanguage(
  language: string,
  editor?: LexicalEditor,
  codeNodeKey?: NodeKey,
): Promise<void> | void;
declare export function loadCodeTheme(
  theme: string,
  editor?: LexicalEditor,
  codeNodeKey?: NodeKey,
): Promise<void> | void;
declare export function normalizeCodeLanguage(language: string): string;
