{
  "name": "@lexical/code-highlights",
  "description": "This package contains the code highlighter for Lexical using the Highlights engine",
  "keywords": [
    "lexical",
    "editor",
    "rich-text",
    "code"
  ],
  "license": "MIT",
  "version": "0.52.0",
  "main": "./dist/LexicalCodeHighlights.js",
  "types": "./dist/typescript-too-old.d.ts",
  "dependencies": {
    "@lexical/code-core": "workspace:*",
    "@lexical/extension": "workspace:*",
    "@lexical/internal": "workspace:*",
    "@pierre/highlights": "^0.1.3",
    "lexical": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facebook/lexical.git",
    "directory": "packages/lexical-code-highlights"
  },
  "module": "./dist/LexicalCodeHighlights.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types@<5.2": "./dist/typescript-too-old.d.ts",
      "types": "./dist/index.d.ts",
      "development": "./dist/LexicalCodeHighlights.dev.js",
      "production": "./dist/LexicalCodeHighlights.prod.js",
      "default": "./dist/LexicalCodeHighlights.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "!src/__bench__",
    "!src/__mocks__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.bench.ts",
    "!src/**/*.bench.tsx",
    "README.md",
    "LICENSE"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "./dist/typescript-too-old.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "typescript": ">=5.2"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "type": "module"
}
